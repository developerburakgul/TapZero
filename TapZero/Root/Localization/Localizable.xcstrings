        }
      }
    },
    "onboarding.intro2.step2.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشاشة تصبح فارغة. لا ساعة، لا عداد. انقر عندما تشعر أنه الوقت المناسب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm wird leer. Keine Uhr, kein Zähler. Tippe, wenn es sich richtig anfühlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The screen goes blank. No clock, no counter. Tap when it feels right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla se queda en blanco. Sin reloj, sin contador. Toca cuando lo sientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écran devient vide. Pas d'horloge, pas de compteur. Appuie quand ça te semble juste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo diventa vuoto. Niente orologio, niente contatore. Tocca quando ti sembra giusto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面が空白に。時計もカウンターもなし。感覚でタップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 비워져. 시계도, 카운터도 없어. 느낌이 올 때 탭해."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela fica em branco. Sem relógio, sem contador. Toque quando sentir que é hora."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran boşalır. Saat yok, sayaç yok. Doğru hissettiğinde dokun."
          }
        }
      }
    },
    "onboarding.intro2.step2.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر للبدء"
          }
        },
        "de": {
          "stringUnit": {
