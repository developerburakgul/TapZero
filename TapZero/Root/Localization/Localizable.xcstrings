    "onboarding.intro2.step3.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلما اقتربت من الصفر، كانت نتيجتك أفضل. هل تستطيع الشعور بالوقت بشكل مثالي؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je näher du an Null bist, desto besser dein Score. Kannst du die Zeit perfekt fühlen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The closer you are to zero, the better your score. Can you feel time perfectly?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuanto más cerca de cero, mejor tu puntuación. ¿Puedes sentir el tiempo perfectamente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus tu es proche de zéro, meilleur est ton score. Peux-tu ressentir le temps parfaitement ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più sei vicino allo zero, migliore è il punteggio. Riesci a sentire il tempo perfettamente?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゼロに近いほどスコアが高い。完璧に時間を感じられる？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제로에 가까울수록 점수가 높아. 시간을 완벽하게 느낄 수 있어?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto mais perto de zero, melhor sua pontuação. Consegue sentir o tempo perfeitamente?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfıra ne kadar yakınsan, skorun o kadar iyi. Zamanı mükemmel hissedebilir misin?"
          }
        }
      }
    },
    "onboarding.intro2.step3.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
