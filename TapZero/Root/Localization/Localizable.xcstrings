    "welcome.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول لمتابعة من حيث توقفت، أو ابدأ من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich an, um dort weiterzumachen, wo du aufgehört hast, oder starte neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to pick up where you left off, or start fresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para continuar donde lo dejaste o empieza de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour reprendre là où vous en étiez, ou recommencez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi per riprendere da dove eri rimasto o ricomincia da capo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の続きからサインインするか、新しく始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전에 하던 작업을 이어가려면 로그인하거나 새로 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login para continuar de onde parou ou comece do zero."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaldığın yerden devam etmek için giriş yap veya yeniden başla."
          }
        }
      }
    },
