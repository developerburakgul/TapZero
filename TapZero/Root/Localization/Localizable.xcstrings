    "leaderBoard.empty.daily.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديث لوحة اليوم. العب الآن لتحدد الإيقاع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die heutige Bestenliste wurde zurückgesetzt. Spiel jetzt und gib das Tempo vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's board just reset. Play now to set the pace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tabla de hoy se reinició. Juega ahora para marcar el ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le classement du jour vient d'être réinitialisé. Joue maintenant pour donner le ton."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La classifica di oggi è stata azzerata. Gioca ora per dare il ritmo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のボードがリセットされました。今すぐプレイしてペースを作ろう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 보드가 초기화됐어. 지금 플레이해서 페이스를 만들어봐."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O placar de hoje foi reiniciado. Jogue agora para definir o ritmo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün sıralaması sıfırlandı. Hemen oyna ve tempoyu belirle."
          }
        }
      }
    }
