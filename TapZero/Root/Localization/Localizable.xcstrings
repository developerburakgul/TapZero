    "createAccount.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ حسابًا لحفظ بياناتك ومزامنتها عبر الأجهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie ein Konto, um Ihre Daten zu sichern und geräteübergreifend zu synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an account to save your data and sync across devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una cuenta para guardar tus datos y sincronizar entre dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un compte pour sauvegarder vos données et synchroniser entre appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un account per salvare i tuoi dati e sincronizzarli tra i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを保存してデバイス間で同期するためにアカウントを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 저장하고 기기 간 동기화하려면 계정을 만드세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma conta para salvar seus dados e sincronizar entre dispositivos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerini kaydetmek ve cihazlar arası senkronize etmek için hesap oluştur."
          }
        }
      }
    },
