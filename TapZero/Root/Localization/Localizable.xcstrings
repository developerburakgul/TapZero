    "onboarding.intro3.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تعيين يومية، ترتيب عالمي دائم. شاهد ترتيبك بين جميع اللاعبين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Täglicher Reset, ewige Gesamtwertung. Sieh deinen Rang gegen alle Spieler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily resets, global all-time. See your rank against everyone playing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicio diario, ranking global. Mira tu posición entre todos los jugadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialisation quotidienne, classement global. Vois ton rang parmi tous les joueurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset giornaliero, classifica globale. Vedi il tuo posto tra tutti i giocatori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デイリーリセット、グローバル通算。全プレイヤーの中での順位を確認。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 초기화, 글로벌 통산. 모든 플레이어 중 내 순위를 확인해."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinício diário, ranking global. Veja sua posição entre todos os jogadores."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük sıfırlama, genel sıralama. Tüm oyuncular arasındaki sıranı gör."
          }
        }
      }
    },
