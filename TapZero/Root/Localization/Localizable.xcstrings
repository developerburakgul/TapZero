    "onboarding.notification.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الإشعارات لتبقى على اطلاع بالأخبار والعروض والتحديثات المهمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie Benachrichtigungen, um über Neuigkeiten, Angebote und wichtige Updates informiert zu bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable notifications to stay updated on news, offers, and important updates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones para mantenerte al día con novedades, ofertas y actualizaciones importantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez les notifications pour rester informé des nouveautés, offres et mises à jour importantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le notifiche per restare aggiornato su novità, offerte e aggiornamenti importanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ニュース、オファー、重要なアップデートの通知を受け取りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뉴스, 혜택 및 중요한 업데이트를 받으려면 알림을 활성화하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as notificações para ficar por dentro de novidades, ofertas e atualizações importantes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haberler, teklifler ve önemli güncellemelerden haberdar olmak için bildirimleri etkinleştirin."
          }
        }
      }
    },
