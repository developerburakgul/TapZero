    "leaderBoard.empty.global.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كن أول من يلعب ويحتل مكاناً على المنصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei der Erste und sichere dir einen Podiumsplatz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be the first to play and claim a spot on the podium."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sé el primero en jugar y reclama un lugar en el podio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sois le premier à jouer et réclame une place sur le podium."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sii il primo a giocare e conquista un posto sul podio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初にプレイしてポディウムの座を獲得しよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째로 플레이하고 포디움 자리를 차지해봐."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja o primeiro a jogar e conquiste um lugar no pódio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk oynayan ol ve podyumda yerini al."
          }
        }
      }
    },
