    "settings.deleteAccount.alert.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف جميع بياناتك نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle deine Daten werden dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your data will be permanently deleted. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tus datos se eliminarán permanentemente. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes vos données seront définitivement supprimées. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tuoi dati verranno eliminati in modo permanente. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータが完全に削除されます。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 데이터가 영구적으로 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os seus dados serão excluídos permanentemente. Esta ação não pode ser desfeita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm verilerin kalıcı olarak silinecek. Bu işlem geri alınamaz."
          }
        }
      }
    },
