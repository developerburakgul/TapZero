    "leaderBoard.locked.whyBody": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحتاج بضع جولات لتصنيفك بشكل عادل مقارنة بالآخرين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir brauchen ein paar Runden, um dich fair mit allen anderen zu vergleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need a few rounds to fairly rank you against everyone else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitamos algunas rondas para clasificarte justamente contra los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons besoin de quelques manches pour te classer équitablement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo bisogno di qualche round per classificarti equamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公平にランキングするために数ラウンド必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공정한 순위를 위해 몇 라운드가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisamos de algumas rodadas para classificar você de forma justa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni herkesle adil şekilde sıralayabilmemiz için birkaç tura ihtiyacımız var."
          }
        }
      }
    },
