    "onboarding.intro1.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "TapZero لعبة صغيرة عن إحساسك بالثواني — بدون ساعات، بدون عد، فقط حدسك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TapZero ist ein kleines Spiel über dein Zeitgefühl — keine Uhren, kein Zählen, nur Instinkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TapZero is a tiny game about your sense of seconds — no clocks, no counting, just instinct."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TapZero es un pequeño juego sobre tu sentido del tiempo — sin relojes, sin contar, solo instinto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TapZero est un petit jeu sur ton sens des secondes — pas d'horloge, pas de comptage, juste l'instinct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TapZero è un piccolo gioco sul tuo senso dei secondi — niente orologi, niente conteggi, solo istinto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TapZeroは秒の感覚を試す小さなゲーム — 時計なし、カウントなし、直感だけ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TapZero는 초의 감각을 시험하는 작은 게임 — 시계 없이, 세지 않고, 오직 직감으로."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "TapZero é um pequeno jogo sobre seu senso de segundos — sem relógios, sem contagem, apenas instinto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TapZero, saniye hissini ölçen küçük bir oyun — saat yok, sayma yok, sadece içgüdü."
          }
        }
      }
    },
    "onboarding.intro1.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشعر بالوقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spüre die Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feel the time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siente el tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ressens le temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senti il tempo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間を感じて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 느껴봐."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinta o tempo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanı hisset."
          }
        }
      }
    },
    "onboarding.intro2.step1.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر عدد الثواني التي تريد أن تشعر بها — من 1 إلى 30."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie viele Sekunden du fühlen willst — von 1 bis 30."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick how many seconds you want to feel — anywhere from 1 to 30."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuántos segundos quieres sentir — de 1 a 30."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis combien de secondes tu veux ressentir — de 1 à 30."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quanti secondi vuoi sentire — da 1 a 30."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何秒を感じたいか選ぼう — 1から30まで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 초를 느끼고 싶은지 골라봐 — 1부터 30까지."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha quantos segundos quer sentir — de 1 a 30."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaç saniye hissetmek istediğini seç — 1'den 30'a kadar."
          }
        }
      }
    },
    "onboarding.intro2.step1.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر هدفاً"
